<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="MementoMori" translatesAutoresizingMaskIntoConstraints="NO" id="skull-image">
                                <rect key="frame" x="66.5" y="196" width="260" height="260"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="260" id="skull-width"/>
                                    <constraint firstAttribute="height" constant="260" id="skull-height"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="MOVE &amp; PRAY" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="title-label">
                                <rect key="frame" x="24" y="480" width="345" height="38"/>
                                <fontDescription key="fontDescription" type="system" weight="heavy" pointSize="30"/>
                                <color key="textColor" red="0.906" green="0.835" blue="0.690" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="ERAM QUOD ES · ERIS QUOD SUM" textAlignment="center" lineBreakMode="wordWrap" numberOfLines="2" translatesAutoresizingMaskIntoConstraints="NO" id="motto-label">
                                <rect key="frame" x="24" y="530" width="345" height="42"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="14"/>
                                <color key="textColor" red="0.678" green="0.160" blue="0.130" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <color key="backgroundColor" red="0.035" green="0.032" blue="0.029" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="skull-image" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="skull-center-x"/>
                            <constraint firstItem="skull-image" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" constant="-100" id="skull-center-y"/>
                            <constraint firstItem="title-label" firstAttribute="top" secondItem="skull-image" secondAttribute="bottom" constant="24" id="title-top"/>
                            <constraint firstItem="title-label" firstAttribute="leading" secondItem="launch-safe-area" secondAttribute="leading" constant="24" id="title-leading"/>
                            <constraint firstItem="launch-safe-area" firstAttribute="trailing" secondItem="title-label" secondAttribute="trailing" constant="24" id="title-trailing"/>
                            <constraint firstItem="motto-label" firstAttribute="top" secondItem="title-label" secondAttribute="bottom" constant="10" id="motto-top"/>
                            <constraint firstItem="motto-label" firstAttribute="leading" secondItem="launch-safe-area" secondAttribute="leading" constant="24" id="motto-leading"/>
                            <constraint firstItem="launch-safe-area" firstAttribute="trailing" secondItem="motto-label" secondAttribute="trailing" constant="24" id="motto-trailing"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="MementoMori" width="256" height="256"/>
    </resources>
</document>
